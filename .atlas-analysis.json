  "keyFeatures": [
    "One-command scaffolding for web apps, libraries, docs, and plugins across Python, Go, Node, Java, Kotlin, Ruby, PHP, and Rust",
    "Enforced git-flow with Conventional Commits via git hooks and CI checks",
    "Automated versioned releases with changelog generation for PyPI, npm, Docker, and GitHub",
    "Cloud overlays for AWS Lambda, AWS Amplify, and Docker deployments",
    "MCP server with 36 remote tools for Claude Code, Codex, and Cursor",
    "Role-based access control with scoped tokens (owner, admin, deployer, developer, viewer)",
    "Web app with Organizations → Teams → Projects → Apps hierarchy",
    "Self-hosting via a single install script or Dokploy template",
    "Import existing repositories with automatic platform.toml installation",
    "Custom template catalogs from any git repository"
  ],
